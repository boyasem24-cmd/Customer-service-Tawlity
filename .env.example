# Copy this file to .env and fill in real values. Never commit .env.

# Port the Express server listens on.
PORT=3000

# Base URL agents/customers use to reach this server (no trailing slash).
# Used to build the "open dashboard" link sent in WhatsApp escalations.
DASHBOARD_BASE_URL=http://localhost:3000

# --- WhatsApp Cloud API (Meta) ---
# See README.md "WhatsApp Cloud API setup" for how to get each of these.

# Permanent access token for a System User with whatsapp_business_messaging permission.
WHATSAPP_TOKEN=

# Phone Number ID (NOT the phone number itself) from WhatsApp > API Setup in Meta App Dashboard.
WHATSAPP_PHONE_NUMBER_ID=

# The Graph API version to call.
WHATSAPP_API_VERSION=v20.0

# The phone number that should RECEIVE escalation messages (the agent's phone),
# in international format with no leading +, e.g. 96550001234 for Kuwait.
# In dev/test mode this number MUST be added as a tester number in the Meta App Dashboard.
WHATSAPP_TO_NUMBER=

# Name of the approved message template used for escalations (sent to the agent).
WHATSAPP_TEMPLATE_NAME=ticket_escalated

# Language code the ticket_escalated template was approved in.
WHATSAPP_TEMPLATE_LANG=en_US

# Name of the approved message template used to notify the customer when an
# agent replies. Only used for tickets whose contactType is 'phone'.
WHATSAPP_REPLY_TEMPLATE_NAME=ticket_reply_notification

# Language code the ticket_reply_notification template was approved in.
WHATSAPP_REPLY_TEMPLATE_LANG=en_US
